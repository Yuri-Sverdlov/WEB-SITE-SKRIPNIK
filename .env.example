# Переменные окружения проекта WEB-SITE-SKRIPNIK
#
# ВАЖНО: этот файл (.env.example) хранится в git, а рабочий .env.local — НЕТ
# (он в .gitignore, в репозиторий не попадает). Поэтому на новом компьютере
# после git clone нужно создать .env.local вручную — иначе сайт не подключится к Supabase.
#
# Как создать на новом компьютере:
#   cp .env.example .env.local      (Linux/macOS/git-bash)
#   copy .env.example .env.local    (Windows cmd)
#   В PowerShell: Copy-Item .env.example .env.local
#
# Значения берутся из Supabase Dashboard → Project Settings → API.
# VITE_SUPABASE_ANON_KEY — публичный (publishable) ключ: он всё равно попадает
# в собранный фронтенд. Секретные ключи (service_role / secret) сюда НЕ класть.

VITE_SUPABASE_URL=https://gwsapscczrscskpaayfy.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_N_vSmhLgKWEMNFnrF8FeMA_zMa4GkUF
